# ---------------------------------------------------------------------------
# Serpent configuration.  Copy to .env and edit.  Every value has a
# built-in default, so an empty .env still boots.
# ---------------------------------------------------------------------------

# --- server ---------------------------------------------------------------
# BIND_HOST=0.0.0.0
# BIND_PORT=8971
# LOG_LEVEL=info
# Set to true only when running behind nginx/caddy on the same host.
# TRUST_PROXY=false

# --- storage --------------------------------------------------------------
# DB_PATH=./data/serpent.db

# --- upstream (the actual SERP provider) ----------------------------------
# UPSTREAM_BASE_URL=https://google.serper.dev
# UPSTREAM_TIMEOUT=30
# UPSTREAM_VERIFY_TLS=true
# Max bytes accepted from inbound requests (POST bodies).
# MAX_BODY_BYTES=1048576

# How the account key is attached to the upstream request.
#   header -> AUTH_HEADER_NAME: <key>        (Serper, ScrapingDog, ...)
#   query  -> ?AUTH_PARAM_NAME=<key>         (SerpApi, valueserp, ...)
#   bearer -> Authorization: Bearer <key>
# AUTH_STYLE=header
# AUTH_HEADER_NAME=X-API-KEY
# AUTH_PARAM_NAME=api_key

# Path prefix that is stripped before forwarding to UPSTREAM_BASE_URL.
# Caller:  POST /v1/search   ->   POST https://google.serper.dev/search
# ROUTE_PREFIX=/v1

# --- quota accounting -----------------------------------------------------
# Credits granted to each new account per period.
# DEFAULT_QUOTA_LIMIT=250
# Day of month the window resets (UTC, 1-28). 1 = calendar month.
# QUOTA_RESET_DAY=1
# Credits kept in reserve and never handed out, so you always have headroom
# for urgent checks. e.g. 5 leaves 5 hits per account unspent.
# QUOTA_RESERVE=0

# --- rotation -------------------------------------------------------------
# most_remaining | round_robin | least_in_flight | least_recently_used
# | fill_first | random
# STRATEGY=most_remaining
# How many extra accounts to try when one fails (total attempts = 1 + this).
# MAX_RETRIES=2
# Upstream failures that give the credit back and roll to another account.
# Allowed: connect,5xx,429,401
# REFUND_ON=connect,5xx,429,401
# COOLDOWN_BASE_SECONDS=10
# COOLDOWN_MAX_SECONDS=300

# --- caller authentication ------------------------------------------------
# Comma separated  key[:role]  where role is admin | client | read.
#   admin  -> proxy + management
#   client -> proxy + read quota
#   read   -> read quota / dashboard data only
# Default role when omitted is "client".  LEAVE EMPTY ONLY ON A TRUSTED LAN.
# ROUTER_KEYS=change-me-admin:admin,change-me-client:client,change-me-read:read
# Header (or Authorization: Bearer) used to present the router key.
# ROUTER_KEY_HEADER=X-Router-Key

# --- dashboard ------------------------------------------------------------
# Public read-only dashboard at "/".  Mutations always require an admin key.
# DASHBOARD_PUBLIC=true
# Hide the account label on proxied responses.
# EXPOSE_ACCOUNT_LABEL=true

# --- optional extras ------------------------------------------------------
# Cache identical searches. Cached hits cost no quota. 0 disables.
# CACHE_TTL_SECONDS=0
# CACHE_MAX_ENTRIES=512
# Global token bucket to stop a runaway caller draining every account.
# 0 disables. RATE_LIMIT_BURST defaults to RATE_LIMIT_PER_MINUTE.
# RATE_LIMIT_PER_MINUTE=0
# RATE_LIMIT_BURST=0
# How many recent requests the dashboard remembers (0 disables the log).
# REQUEST_LOG_SIZE=500

# --- first boot seeding ---------------------------------------------------
# "label:key,label:key" - imported once, then managed via API/CLI.
# SERP_ACCOUNTS=
